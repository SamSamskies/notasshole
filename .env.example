# Server-only. Never prefix with VITE_ (that would ship the key to the browser).
# Copy to `.env.local` for local `npx vercel dev` / `npm run dev:vercel`.
# Production: set the same vars in the Vercel project env.
GEMINI_API_KEY=

# Optional. Defaults to gemma-4-31b-it (higher free-tier RPD than 3.5 Flash).
# GEMINI_MODEL=gemma-4-31b-it

# Kill switch without redeploying the client (false/0/off disables /api/judge).
# GEMINI_FALLBACK_ENABLED=true

# Per-browser daily cap (default 50). Shared Google free-tier RPD is the backstop.
# GEMINI_CLIENT_DAILY_LIMIT=50

# Upstash Redis (public recent docket). Free tier is enough.
# Vercel marketplace (`upstash/upstash-kv`) injects these; we only read URL + TOKEN.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Unused extras from `vercel env pull` — safe to ignore.
KV_REST_API_READ_ONLY_TOKEN=
KV_URL=
REDIS_URL=

# Optional aliases if you create the DB in the Upstash console instead of Vercel.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional. Per-browser daily docket writes (default 50).
# DOCKET_CLIENT_DAILY_LIMIT=50
