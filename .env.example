# Server-only. Never prefix with VITE_ (that would ship the key to the browser).
# Copy to `.env.local` for local `npx vercel dev` / `npm run dev:vercel`.
# Production: set the same vars in the Vercel project env.
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.5-flash on the server.
# (gemini-2.5-flash often 404s for new free-tier API keys.)
# GEMINI_MODEL=gemini-3.5-flash

# Kill switch without redeploying the client (false/0/off disables /api/judge).
# GEMINI_FALLBACK_ENABLED=true

# Comma-separated browser Origins allowed to POST (defaults include localhost).
# ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:3000

# Per-browser daily cap (default 20). Shared Google free-tier RPD is the backstop.
# GEMINI_CLIENT_DAILY_LIMIT=20
